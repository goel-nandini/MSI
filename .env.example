# ==============================================================================
# Bunny.net Stream API Configuration
# Documentation: https://bunny.net/docs/api-reference/stream
# ==============================================================================

# Your Video Library ID (Found in Bunny.net dashboard -> Stream -> Your Library)
BUNNY_STREAM_LIBRARY_ID=389201
NEXT_PUBLIC_BUNNY_STREAM_LIBRARY_ID=389201

# Your Stream API Key / AccessKey (Found in Bunny.net dashboard -> Stream -> Library Settings -> API)
BUNNY_STREAM_API_KEY=your_bunny_stream_access_key_here

# Your Bunny CDN Hostname (e.g. vz-xxxx.b-cdn.net or video.bunnycdn.com)
BUNNY_STREAM_CDN_HOSTNAME=vz-389201.b-cdn.net
NEXT_PUBLIC_BUNNY_STREAM_CDN_HOSTNAME=vz-389201.b-cdn.net

# ==============================================================================
# ApiTxt Unified OTP API Configuration (Primary SMS / WhatsApp Gateway)
# Documentation: https://apitxt.com/developer/otp-api
# Endpoint: https://apitxt.com/api/sendOTP
# Get your API key:
# 1. Sign up / login at https://apitxt.com
# 2. Go to Dashboard -> API Keys
# 3. Copy your unique API Authentication Key and paste below
# ==============================================================================
APITXT_AUTH_KEY=your_apitxt_auth_key_here

# Optional ApiTxt settings:
APITXT_CHANNEL=sms
# APITXT_TEMPLATE_ID=
# APITXT_PROJECT_REF_ID=

# ==============================================================================
# Fast2SMS Mobile OTP Configuration (Secondary / Fallback Gateway)
# Documentation: https://www.fast2sms.com/dev/bulkV2
# ==============================================================================
FAST2SMS_API_KEY=
